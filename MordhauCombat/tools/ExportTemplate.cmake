cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED SKYRIM_TEMPLATE_ARCHIVE)
    set(SKYRIM_TEMPLATE_ARCHIVE "${root}/../Template.zip")
endif()
set(stage "${root}/build/template-export")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/cmake" "${stage}/tools/web-package")
foreach(item CMakeLists.txt CMakePresets.json CMake_Build.bat project.cmake dependencies.lock.json README.MD LICENSE .gitignore include src pch resource data)
    file(COPY "${root}/${item}" DESTINATION "${stage}")
endforeach()
foreach(item LibraryCache.cmake WebCache.cmake Dependencies.cmake SDKCompatibility.cmake PluginVersion.h.in)
    file(COPY "${root}/cmake/${item}" DESTINATION "${stage}/cmake")
endforeach()
foreach(item PrepareLibraries.cmake BuildWeb.cmake PackageMod.cmake ExportTemplate.cmake lock_dependencies.py)
    file(COPY "${root}/tools/${item}" DESTINATION "${stage}/tools")
endforeach()
file(COPY "${root}/tools/web-package/package.json" "${root}/tools/web-package/package-lock.json" DESTINATION "${stage}/tools/web-package")
file(GLOB contents RELATIVE "${stage}" "${stage}/*" "${stage}/.gitignore")
list(REMOVE_DUPLICATES contents)
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${SKYRIM_TEMPLATE_ARCHIVE}" --format=zip -- ${contents}
    WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Exported ${SKYRIM_TEMPLATE_ARCHIVE}")
