include("${CMAKE_CURRENT_LIST_DIR}/LibraryCache.cmake")
set(SKYRIM_EXTERN_DIR "${CMAKE_SOURCE_DIR}/extern")

skyrim_library(spdlog spdlog_source)
set(SPDLOG_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(SPDLOG_INSTALL ON CACHE BOOL "" FORCE)
set(SPDLOG_FMT_EXTERNAL OFF CACHE BOOL "" FORCE)
add_subdirectory("${spdlog_source}" "${CMAKE_BINARY_DIR}/libraries/spdlog" EXCLUDE_FROM_ALL)

skyrim_library(directxtk directxtk_source)
set(BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(BUILD_XAUDIO_WIN8 OFF CACHE BOOL "" FORCE)
set(BUILD_XAUDIO_WIN10 OFF CACHE BOOL "" FORCE)
set(BUILD_XAUDIO_REDIST OFF CACHE BOOL "" FORCE)
# Use the installed Windows SDK's DirectXMath, not an unpinned global package.
set(CMAKE_DISABLE_FIND_PACKAGE_directxmath TRUE)
add_subdirectory("${directxtk_source}" "${CMAKE_BINARY_DIR}/libraries/directxtk" EXCLUDE_FROM_ALL)
if(NOT TARGET Microsoft::DirectXTK)
    add_library(Microsoft::DirectXTK ALIAS DirectXTK)
endif()

# Upstream CommonLib uses find_package for these already-built source targets.
file(WRITE "${CMAKE_FIND_PACKAGE_REDIRECTS_DIR}/spdlog-config.cmake"
    "if(NOT TARGET spdlog::spdlog)\n message(FATAL_ERROR \"Local spdlog target is missing\")\nendif()\nset(spdlog_INCLUDE_DIRS \"${spdlog_source}/include\")\nset(spdlog_FOUND TRUE)\n")
file(WRITE "${CMAKE_FIND_PACKAGE_REDIRECTS_DIR}/directxtk-config.cmake"
    "if(NOT TARGET Microsoft::DirectXTK)\n message(FATAL_ERROR \"Local DirectXTK target is missing\")\nendif()\nset(directxtk_FOUND TRUE)\n")

skyrim_library(xbyak xbyak_source)
skyrim_library(rapidcsv rapidcsv_source)
skyrim_library(minhook minhook_source)
skyrim_library(commonlib_ng commonlib_source)
