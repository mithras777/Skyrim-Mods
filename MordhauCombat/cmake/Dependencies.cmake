set(REX_OPTION_JSON ${MOD_WITH_JSON} CACHE BOOL "" FORCE)
set(REX_OPTION_INI ${MOD_WITH_INI} CACHE BOOL "" FORCE)
set(REX_OPTION_TOML ${MOD_WITH_TOML} CACHE BOOL "" FORCE)
add_subdirectory("${commonlib_source}" "${CMAKE_BINARY_DIR}/libraries/commonlib" EXCLUDE_FROM_ALL)
target_compile_options(CommonLibSSE PRIVATE /MP6 /bigobj)
target_include_directories(CommonLibSSE PUBLIC "$<BUILD_INTERFACE:${xbyak_source}>")

function(skyrim_headers target directory)
    add_library("${target}" INTERFACE)
    target_include_directories("${target}" INTERFACE "${directory}")
    set_property(GLOBAL APPEND PROPERTY SKYRIM_OPTIONAL_TARGETS "${target}")
endfunction()

