include_guard(GLOBAL)
get_filename_component(SKYRIM_TEMPLATE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(SKYRIM_LIBRARIES_DIR "${SKYRIM_TEMPLATE_ROOT}/../Libraries" CACHE PATH "Shared pinned source cache")
get_filename_component(SKYRIM_LIBRARIES_DIR "${SKYRIM_LIBRARIES_DIR}" ABSOLUTE BASE_DIR "${SKYRIM_TEMPLATE_ROOT}")
option(SKYRIM_ALLOW_DOWNLOADS "Download missing locked dependencies into Libraries" ON)
file(READ "${SKYRIM_TEMPLATE_ROOT}/dependencies.lock.json" SKYRIM_DEPENDENCY_LOCK)

function(skyrim_library id output)
    if(NOT id MATCHES "^[a-z0-9_]+$")
        message(FATAL_ERROR "Invalid dependency id: ${id}")
    endif()
    string(JSON revision GET "${SKYRIM_DEPENDENCY_LOCK}" libraries "${id}" revision)
    string(JSON sha256 GET "${SKYRIM_DEPENDENCY_LOCK}" libraries "${id}" sha256)
    string(JSON url GET "${SKYRIM_DEPENDENCY_LOCK}" libraries "${id}" url)
    string(JSON required GET "${SKYRIM_DEPENDENCY_LOCK}" libraries "${id}" required)
    string(LENGTH "${revision}" revision_length)
    if(NOT revision_length EQUAL 40 OR NOT revision MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Dependency ${id} must be locked to a full commit")
    endif()
    set(identity "${revision}\n${sha256}\n")
    set(cached "${SKYRIM_LIBRARIES_DIR}/native/${id}/${revision}")
    set(destination "${cached}")
    if(NOT SKYRIM_PREPARE_ONLY)
        set(destination "${SKYRIM_EXTERN_DIR}/${id}/${revision}")
    endif()
    if(EXISTS "${destination}/.skyrim-source" AND EXISTS "${destination}/${required}")
        file(READ "${destination}/.skyrim-source" installed_identity)
        if(installed_identity STREQUAL identity)
            set(${output} "${destination}" PARENT_SCOPE)
            set_property(GLOBAL APPEND PROPERTY SKYRIM_USED_LIBRARIES "${id}")
            return()
        endif()
        message(FATAL_ERROR "${destination} has a different dependency identity. Move this local copy aside before configuring again.")
    endif()
    file(MAKE_DIRECTORY "${SKYRIM_LIBRARIES_DIR}/.locks")
    file(LOCK "${SKYRIM_LIBRARIES_DIR}/.locks/${id}-${revision}.lock" GUARD FUNCTION TIMEOUT 300 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Could not lock ${id}: ${lock_result}")
    endif()
    if(NOT EXISTS "${cached}/.skyrim-source")
        set(archive "${SKYRIM_LIBRARIES_DIR}/.archives/${id}-${revision}.zip")
        file(MAKE_DIRECTORY "${SKYRIM_LIBRARIES_DIR}/.archives")
        if(NOT EXISTS "${archive}")
            if(NOT SKYRIM_ALLOW_DOWNLOADS)
                message(FATAL_ERROR "Missing locked library ${id} (${revision}). Run cmake -P tools/PrepareLibraries.cmake online, or set SKYRIM_LIBRARIES_DIR to a populated cache.")
            endif()
            message(STATUS "Downloading ${id} ${revision} into Libraries")
            file(DOWNLOAD "${url}" "${archive}.part" TLS_VERIFY ON TIMEOUT 300 EXPECTED_HASH "SHA256=${sha256}" STATUS download_status)
            list(GET download_status 0 download_code)
            if(NOT download_code EQUAL 0)
                file(REMOVE "${archive}.part")
                message(FATAL_ERROR "Download failed for ${id}: ${download_status}")
            endif()
            file(RENAME "${archive}.part" "${archive}")
        endif()
        file(SHA256 "${archive}" actual_hash)
        if(NOT actual_hash STREQUAL sha256)
            message(FATAL_ERROR "Archive hash mismatch for ${id}: ${archive}. Remove the corrupt archive and retry; no ready cache entry was created.")
        endif()
        set(staging "${cached}.staging")
        set(unpack "${cached}.unpack")
        file(REMOVE_RECURSE "${staging}" "${unpack}")
        file(MAKE_DIRECTORY "${unpack}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${unpack}")
        file(GLOB archive_roots LIST_DIRECTORIES TRUE "${unpack}/*")
        list(LENGTH archive_roots root_count)
        if(NOT root_count EQUAL 1)
            message(FATAL_ERROR "Unexpected archive layout for ${id}")
        endif()
        list(GET archive_roots 0 archive_root)
        if(NOT EXISTS "${archive_root}/${required}")
            message(FATAL_ERROR "Incomplete ${id} archive: ${required} is missing")
        endif()
        file(RENAME "${archive_root}" "${staging}")
        file(REMOVE_RECURSE "${unpack}")
        file(WRITE "${staging}/.skyrim-source" "${identity}")
        if(EXISTS "${cached}")
            message(FATAL_ERROR "Incomplete cache directory ${cached}; move it aside before retrying")
        endif()
        file(RENAME "${staging}" "${cached}")
    endif()
    file(READ "${cached}/.skyrim-source" cached_identity)
    if(NOT cached_identity STREQUAL identity OR NOT EXISTS "${cached}/${required}")
        message(FATAL_ERROR "Cache identity or required file mismatch for ${id}: ${cached}")
    endif()
    if(NOT SKYRIM_PREPARE_ONLY)
        if(EXISTS "${destination}/.skyrim-source")
            file(READ "${destination}/.skyrim-source" installed_identity)
            if(installed_identity STREQUAL identity AND EXISTS "${destination}/${required}")
                set(${output} "${destination}" PARENT_SCOPE)
                set_property(GLOBAL APPEND PROPERTY SKYRIM_USED_LIBRARIES "${id}")
                return()
            endif()
        endif()
        if(EXISTS "${destination}")
            message(FATAL_ERROR "Unmanaged or incomplete local library ${destination}; move it aside before retrying")
        endif()
        file(REMOVE_RECURSE "${destination}.staging")
        file(MAKE_DIRECTORY "${destination}.staging")
        file(COPY "${cached}/" DESTINATION "${destination}.staging" PATTERN ".git" EXCLUDE)
        file(RENAME "${destination}.staging" "${destination}")
        message(STATUS "Copied ${id} from Libraries")
    endif()
    set(${output} "${destination}" PARENT_SCOPE)
    set_property(GLOBAL APPEND PROPERTY SKYRIM_USED_LIBRARIES "${id}")
endfunction()
