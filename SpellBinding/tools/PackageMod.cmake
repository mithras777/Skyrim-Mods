cmake_minimum_required(VERSION 3.24)
set(dist "${PROJECT_DIR}/dist")
set(stage "${dist}/stage/${BUILD_CONFIG}")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/SKSE/Plugins" "${stage}/licenses/${PLUGIN_NAME}")
if(EXISTS "${PROJECT_DIR}/data")
    file(COPY "${PROJECT_DIR}/data/" DESTINATION "${stage}" PATTERN ".gitkeep" EXCLUDE)
endif()
# Fresh binaries and notices win over stale files accidentally left under data.
file(COPY "${PLUGIN_FILE}" DESTINATION "${stage}/SKSE/Plugins")
if(EXISTS "${SYMBOL_FILE}")
    file(COPY "${SYMBOL_FILE}" DESTINATION "${stage}/SKSE/Plugins")
endif()
file(COPY "${NOTICE_DIR}/" DESTINATION "${stage}/licenses/${PLUGIN_NAME}")
file(COPY "${PROJECT_DIR}/dependencies.lock.json" DESTINATION "${stage}/licenses/${PLUGIN_NAME}")
file(COPY "${PROJECT_DIR}/LICENSE.txt" DESTINATION "${stage}")
if(EXISTS "${PROJECT_DIR}/licenses")
    file(COPY "${PROJECT_DIR}/licenses/" DESTINATION "${stage}/licenses/${PLUGIN_NAME}")
endif()
set(package_readme "${PLUGIN_NAME}\nCopyright (C) 2025-2026 ${PLUGIN_AUTHOR}.\n\nThe original source code for this mod is licensed under the GNU General Public License, version 3 or (at your option) any later version. It is provided without any warranty, including the implied warranties of merchantability or fitness for a particular purpose. The full, unmodified license text is in LICENSE.txt. Official GPL-3.0 text: https://www.gnu.org/licenses/gpl-3.0.html.\n\n")
if(DEFINED MOD_SOURCE_URL AND NOT MOD_SOURCE_URL STREQUAL "")
    string(APPEND package_readme "Public source code: ${MOD_SOURCE_URL}\n")
else()
    string(APPEND package_readme "Public source code: set MOD_SOURCE_URL in project.cmake before publishing.\n")
endif()
string(APPEND package_readme "Pinned CommonLibSSE-NG revision: a6d3ea4642f71fb92ac3e0d7fef5808217f8aae9. Its GPL-3.0-or-later license and Modding and Linking Exceptions are included in licenses/${PLUGIN_NAME}/commonlib_ng/. Exact dependency revisions and source archive hashes are recorded in licenses/${PLUGIN_NAME}/dependencies.lock.json. Template-derived portions retain ArranzCNL's MIT notice in licenses/${PLUGIN_NAME}/third-party/. Other bundled components and assets retain their applicable notices and terms.\n")
file(WRITE "${stage}/README.txt" "${package_readme}")
if(INCLUDE_WEB)
    file(COPY "${WEB_DIR}/package-lock.json" DESTINATION "${stage}/licenses/${PLUGIN_NAME}/web")
    file(GLOB npm_packages LIST_DIRECTORIES TRUE "${WEB_DIR}/node_modules/*" "${WEB_DIR}/node_modules/@*/*")
    foreach(npm_package IN LISTS npm_packages)
        if(EXISTS "${npm_package}/package.json")
            file(READ "${npm_package}/package.json" npm_metadata)
            string(JSON npm_name GET "${npm_metadata}" name)
            string(REPLACE "/" "__" npm_notice_name "${npm_name}")
            file(GLOB npm_licenses "${npm_package}/LICENSE*" "${npm_package}/license*" "${npm_package}/COPYING*" "${npm_package}/NOTICE*")
            set(npm_notice_dir "${stage}/licenses/${PLUGIN_NAME}/web/${npm_notice_name}")
            file(MAKE_DIRECTORY "${npm_notice_dir}")
            file(COPY "${npm_package}/package.json" DESTINATION "${npm_notice_dir}")
            if(npm_licenses)
                file(COPY ${npm_licenses} DESTINATION "${npm_notice_dir}")
            endif()
        endif()
    endforeach()
    file(GLOB web_outputs "${WEB_DIR}/*.html" "${WEB_DIR}/*.css" "${WEB_DIR}/*.js")
    file(MAKE_DIRECTORY "${stage}/PrismaUI/views/${PLUGIN_NAME}")
    if(web_outputs)
        file(COPY ${web_outputs} DESTINATION "${stage}/PrismaUI/views/${PLUGIN_NAME}")
    endif()
    if(EXISTS "${WEB_DIR}/assets")
        file(COPY "${WEB_DIR}/assets" DESTINATION "${stage}/PrismaUI/views/${PLUGIN_NAME}")
    endif()
endif()
file(GLOB package_roots RELATIVE "${stage}" "${stage}/*")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${dist}/${PLUGIN_NAME}-${PLUGIN_VERSION}-${BUILD_CONFIG}.zip" --format=zip -- ${package_roots}
    WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Packaged ${dist}/${PLUGIN_NAME}-${PLUGIN_VERSION}-${BUILD_CONFIG}.zip")