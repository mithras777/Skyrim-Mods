include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/LibraryCache.cmake")
function(skyrim_web_dependencies)
    if(NOT EXISTS "${SKYRIM_WEB_DIR}/package.json" OR NOT EXISTS "${SKYRIM_WEB_DIR}/package-lock.json")
        message(FATAL_ERROR "Web builds require package.json and package-lock.json in SKYRIM_WEB_DIR=${SKYRIM_WEB_DIR}")
    endif()
    find_program(NODE_EXECUTABLE NAMES node REQUIRED)
    find_program(NPM_EXECUTABLE NAMES npm.cmd npm REQUIRED)
    file(READ "${SKYRIM_WEB_DIR}/package.json" package_json)
    file(READ "${SKYRIM_WEB_DIR}/package-lock.json" package_lock)
    foreach(section dependencies devDependencies optionalDependencies)
        string(JSON declared ERROR_VARIABLE declared_error GET "${package_json}" "${section}")
        string(JSON locked ERROR_VARIABLE locked_error GET "${package_lock}" packages "" "${section}")
        if(declared_error)
            set(declared "{}")
        endif()
        if(locked_error)
            set(locked "{}")
        endif()
        if(NOT declared STREQUAL locked)
            message(FATAL_ERROR "package.json ${section} differs from package-lock.json. Update the lock before using the web cache.")
        endif()
    endforeach()
    execute_process(COMMAND "${NODE_EXECUTABLE}" -p "process.platform + '-' + process.arch" OUTPUT_VARIABLE platform OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT platform STREQUAL "win32-x64")
        message(FATAL_ERROR "The web cache currently supports Windows x64, got ${platform}")
    endif()
    file(SHA256 "${SKYRIM_WEB_DIR}/package-lock.json" lock_hash)
    set(destination "${SKYRIM_WEB_DIR}/node_modules")
    if(NOT SKYRIM_PREPARE_ONLY AND EXISTS "${destination}/.skyrim-lock")
        file(READ "${destination}/.skyrim-lock" local_lock)
        if(local_lock STREQUAL "${lock_hash}\n${platform}\n")
            return()
        endif()
        message(FATAL_ERROR "Web dependency lock changed. Move ${destination} aside and run the web build again.")
    endif()
    set(cached "${SKYRIM_LIBRARIES_DIR}/web/${lock_hash}/${platform}")
    file(MAKE_DIRECTORY "${SKYRIM_LIBRARIES_DIR}/.locks")
    file(LOCK "${SKYRIM_LIBRARIES_DIR}/.locks/web-${lock_hash}-${platform}.lock" GUARD FUNCTION TIMEOUT 300)
    if(NOT EXISTS "${cached}/node_modules/.skyrim-lock")
        if(NOT SKYRIM_ALLOW_DOWNLOADS)
            message(FATAL_ERROR "Missing web dependency cache ${lock_hash} for ${platform}. Prepare Libraries online first.")
        endif()
        file(REMOVE_RECURSE "${cached}.staging")
        file(MAKE_DIRECTORY "${cached}.staging")
        file(COPY "${SKYRIM_WEB_DIR}/package.json" "${SKYRIM_WEB_DIR}/package-lock.json" DESTINATION "${cached}.staging")
        execute_process(COMMAND "${NPM_EXECUTABLE}" ci --no-audit --no-fund --cache "${SKYRIM_LIBRARIES_DIR}/npm-cache" WORKING_DIRECTORY "${cached}.staging" RESULT_VARIABLE npm_result)
        if(NOT npm_result EQUAL 0)
            message(FATAL_ERROR "npm ci failed; the web cache was not published")
        endif()
        file(WRITE "${cached}.staging/node_modules/.skyrim-lock" "${lock_hash}\n${platform}\n")
        if(EXISTS "${cached}")
            message(FATAL_ERROR "Incomplete web cache ${cached}; move it aside and retry")
        endif()
        file(RENAME "${cached}.staging" "${cached}")
    endif()
    file(READ "${cached}/node_modules/.skyrim-lock" cache_lock)
    if(NOT cache_lock STREQUAL "${lock_hash}\n${platform}\n")
        message(FATAL_ERROR "Web cache identity mismatch: ${cached}")
    endif()
    if(NOT SKYRIM_PREPARE_ONLY)
        # A second process may have installed the project copy while waiting on the lock.
        if(EXISTS "${destination}/.skyrim-lock")
            file(READ "${destination}/.skyrim-lock" local_lock)
            if(local_lock STREQUAL "${lock_hash}\n${platform}\n")
                return()
            endif()
        endif()
        if(EXISTS "${destination}")
            message(FATAL_ERROR "Unmanaged node_modules at ${destination}; move it aside before using the shared cache")
        endif()
        file(REMOVE_RECURSE "${destination}.staging")
        file(MAKE_DIRECTORY "${destination}.staging")
        file(COPY "${cached}/node_modules/" DESTINATION "${destination}.staging")
        file(RENAME "${destination}.staging" "${destination}")
        message(STATUS "Copied web dependencies from Libraries")
    endif()
endfunction()
