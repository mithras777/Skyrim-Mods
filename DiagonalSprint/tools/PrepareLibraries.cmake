cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/LibraryCache.cmake")
set(SKYRIM_PREPARE_ONLY TRUE)
string(JSON library_count LENGTH "${SKYRIM_DEPENDENCY_LOCK}" libraries)
math(EXPR last_library "${library_count} - 1")
foreach(index RANGE 0 ${last_library})
    string(JSON id MEMBER "${SKYRIM_DEPENDENCY_LOCK}" libraries ${index})
    skyrim_library("${id}" prepared)
    message(STATUS "Ready: ${id}")
endforeach()
if(NOT DEFINED SKYRIM_PREPARE_WEB OR SKYRIM_PREPARE_WEB)
    set(SKYRIM_WEB_DIR "${CMAKE_CURRENT_LIST_DIR}/web-package")
    include("${CMAKE_CURRENT_LIST_DIR}/../cmake/WebCache.cmake")
    skyrim_web_dependencies()
endif()
message(STATUS "Libraries ready at ${SKYRIM_LIBRARIES_DIR}")
